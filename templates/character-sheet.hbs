<div class="mr-sheet">
  <header class="mr-sheet__head">
    <button type="button" class="mr-portrait" data-action="mrEditImage" aria-label="{{localize 'MR.Character.Portrait'}}"><img src="{{actor.img}}" alt=""></button>
    <div class="mr-grow">
      <input type="text" name="name" value="{{actor.name}}" aria-label="{{localize 'MR.Character.Name'}}" {{#unless editable}}disabled{{/unless}}>
      <input type="text" name="system.concept" value="{{system.concept}}" placeholder="{{localize 'MR.Character.Concept'}}" {{#unless editable}}disabled{{/unless}}>
    </div>
  </header>
  <div class="mr-field"><label for="mr-notes-{{actor.id}}">{{localize "MR.Character.Notes"}}</label><textarea id="mr-notes-{{actor.id}}" name="system.notes" rows="10" {{#unless editable}}disabled{{/unless}}>{{system.notes}}</textarea></div>
  <p class="mr-help">{{localize "MR.Character.SheetHelp"}}</p>
</div>
