<section class="mr-phase">
  <header class="mr-phase__head">
    <h2 class="mr-h1">{{localize "MR.Characters.Title"}}</h2>
    {{#if @root.phaseCard}}{{> "systems/mr-story-night/templates/parts/phase-card.hbs" @root.phaseCard}}{{else}}<p class="mr-help">{{localize "MR.Characters.Help"}}</p>{{/if}}
  </header>
  <ul class="mr-seat-rows">
    {{#each rows}}
    <li class="mr-seat-card {{#if isMine}}is-mine{{/if}} {{#if ready}}is-ready{{/if}}">
      <div class="mr-seat-card__head"><span class="mr-eyebrow">{{seat.name}}{{#if isMine}} · {{localize "MR.Characters.You"}}{{/if}}</span>{{#if ready}}<span class="mr-badge mr-badge--ok"><i class="fa-solid fa-check"></i>{{localize "MR.Characters.Ready"}}</span>{{else}}<span class="mr-badge">{{localize "MR.Characters.Writing"}}</span>{{/if}}</div>
      {{#with main}}
      <button type="button" class="mr-seat-card__char" data-action="openSheet" data-actor-id="{{id}}">
        <span class="mr-avatar mr-avatar--lg">{{#if img}}<img src="{{img}}" alt="">{{else}}{{initials}}{{/if}}</span>
        <span class="mr-seat-card__text">
          <strong>{{displayName}}</strong>
          <small>{{#if concept}}{{concept}}{{else}}<em>{{localize "MR.Characters.NoConcept"}}</em>{{/if}}</small>
          {{#if desire}}<small class="mr-line"><i class="fa-solid fa-heart"></i>{{desire}}</small>{{/if}}
          {{#if want}}<small class="mr-line"><i class="fa-solid fa-arrow-left-long"></i>{{want}}</small>{{/if}}
        </span>
      </button>
      {{/with}}
      {{#if minor}}<p class="mr-seat-card__minor"><span class="mr-label">{{localize "MR.Role.minor"}}</span> <button type="button" class="mr-link" data-action="openSheet" data-actor-id="{{minor.id}}">{{minor.displayName}}</button>{{#if minor.concept}} · {{minor.concept}}{{/if}}</p>{{/if}}
      {{#if canEdit}}
      <div class="mr-seat-card__actions">
        <button type="button" data-action="openSheet" data-actor-id="{{main.id}}"><i class="fa-solid fa-id-card"></i>{{localize "MR.Character.OpenSheet"}}</button>
        {{#if ready}}<button type="button" data-action="op" data-op="setReady" data-args='{"seatId":"{{seat.id}}","ready":false}'>{{localize "MR.Characters.NotReady"}}</button>
        {{else}}<button type="button" class="mr-primary" data-action="op" data-op="setReady" data-args='{"seatId":"{{seat.id}}","ready":true}' {{#unless complete}}disabled data-tooltip="{{localize 'MR.Error.NeedMain'}}"{{/unless}}><i class="fa-solid fa-check"></i>{{localize "MR.Characters.MarkReady"}}</button>{{/if}}
      </div>
      {{/if}}
    </li>
    {{/each}}
  </ul>
  <footer class="mr-phase__foot">
    <span class="mr-progress-text">{{localize "MR.Characters.ReadyCount" n=readyCount total=total}}</span>
    {{#if canForce}}<button type="button" data-action="op" data-op="charactersDone" data-args='{"force":true}'>{{localize "MR.Action.Force"}}</button>{{/if}}
    <button type="button" class="mr-primary" data-action="op" data-op="charactersDone" {{#unless allReady}}disabled{{/unless}}>{{localize "MR.Characters.Continue"}}<i class="fa-solid fa-arrow-right"></i></button>
  </footer>
</section>
