<div class="mr-stones-layout {{#if compact}}is-compact{{/if}}">
  {{#unless compact}}
  <div class="mr-bowl-wrap">
    <div class="mr-bowl" role="img" aria-label="{{localize 'MR.Stones.BowlLabel' n=stoneTotal}}">{{#each bowl}}<i class="mr-stone mr-stone--hidden" style="left:{{x}}%;top:{{y}}%;--r:{{rot}}deg"></i>{{/each}}</div>
    <p class="mr-bowl-count">{{localize "MR.Stones.Count" n=stoneTotal}}</p>
    {{#if carried}}<p class="mr-note">{{localize "MR.Stones.Carried" successes=carried.successes failures=carried.failures}}</p>{{/if}}
    <ul class="mr-submitted">{{#each submittedSeats}}<li class="{{#if done}}is-done{{/if}}"><i class="fa-solid {{#if done}}fa-circle-check{{else}}fa-circle{{/if}}"></i>{{name}}</li>{{/each}}</ul>
  </div>
  {{/unless}}
  <div class="mr-stone-forms">
    {{#unless compact}}<p class="mr-help">{{localize "MR.Stones.Help"}}</p>{{/unless}}
    {{#each forms}}
    <article class="mr-stone-form">
      <h3 class="mr-h3"><i class="fa-solid fa-user-secret"></i>{{localize "MR.Stones.For" name=charName}}</h3>
      <p class="mr-q">{{localize "MR.Stones.DiscontentQ"}}</p>
      <div class="mr-choice-row">{{#each discontent}}<button type="button" class="mr-choice {{#if selected}}is-selected{{/if}}" data-action="stoneDraft" data-seat-id="{{../seatId}}" data-key="discontent" data-value="{{value}}" aria-pressed="{{#if selected}}true{{else}}false{{/if}}"><span class="mr-choice__stones">{{#each reds}}<i class="mr-stone mr-stone--red mr-stone--sm"></i>{{else}}<i class="fa-regular fa-face-smile"></i>{{/each}}</span><strong>{{label}}</strong><small>{{hint}}</small></button>{{/each}}</div>
      <p class="mr-q">{{localize "MR.Stones.VerdictQ"}}</p>
      <div class="mr-choice-row mr-choice-row--2">{{#each verdicts}}<button type="button" class="mr-choice {{#if selected}}is-selected{{/if}}" data-action="stoneDraft" data-seat-id="{{../seatId}}" data-key="verdict" data-value="{{value}}" aria-pressed="{{#if selected}}true{{else}}false{{/if}}"><span class="mr-choice__stones"><i class="mr-stone mr-stone--{{value}} mr-stone--sm"></i></span><strong>{{label}}</strong></button>{{/each}}</div>
      <button type="button" class="mr-primary mr-block" data-action="submitStones" data-seat-id="{{seatId}}" {{#unless canSubmit}}disabled{{/unless}}><i class="fa-solid fa-hand-holding"></i>{{localize "MR.Stones.Submit"}}</button>
    </article>
    {{else}}
    {{#if reveal}}
    <div class="mr-reveal">
      <h3 class="mr-h3"><i class="fa-solid fa-eye"></i>{{localize "MR.Stones.RevealTitle"}}</h3>
      <p class="mr-help">{{localize "MR.Stones.RevealHelp"}}</p>
      <ul>{{#each reveal}}<li><strong>{{charName}}</strong> <small>{{seat}}</small><span class="mr-reveal__stones">{{#each reds}}<i class="mr-stone mr-stone--red mr-stone--sm"></i>{{/each}}<em>{{discontent}}</em> · <i class="mr-stone mr-stone--{{verdict}} mr-stone--sm"></i><em>{{verdictLabel}}</em></span></li>{{/each}}</ul>
    </div>
    {{/if}}
    {{#unless allIn}}<p class="mr-waiting"><i class="fa-solid fa-hourglass-half"></i>{{localize "MR.Stones.Waiting"}}</p>{{/unless}}
    {{/each}}
    {{#unless compact}}
    {{#if showActForAll}}<label class="mr-check"><input type="checkbox" data-action-change="actForAll" {{#if actForAll}}checked{{/if}}>{{localize "MR.Stones.ActForAll"}}</label>{{/if}}
    <footer class="mr-phase__foot">
      {{#if canForce}}<button type="button" data-action="op" data-op="draw" data-args='{"force":true}'>{{localize "MR.Action.Force"}}</button>{{/if}}
      <button type="button" class="mr-primary mr-large" data-action="op" data-op="draw" {{#unless allIn}}disabled{{/unless}}><i class="fa-solid fa-hand-sparkles"></i>{{localize "MR.Stones.Draw"}}</button>
    </footer>
    {{/unless}}
  </div>
</div>
