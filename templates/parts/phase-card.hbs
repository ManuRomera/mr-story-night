<div class="mr-phase-card">
  <p class="mr-phase-card__now">{{now}}</p>
  <p class="mr-phase-card__why"><strong>{{localize "MR.Guide.Why"}}:</strong> {{why}}</p>
  <p class="mr-phase-card__actions"><button type="button" class="mr-link" data-action="mrTab" data-tab="guide" data-anchor="{{key}}">{{localize "MR.Guide.More"}}</button><span aria-hidden="true">·</span><button type="button" class="mr-link mr-link--quiet" data-action="toggleGuide">{{localize "MR.Guide.Hide"}}</button></p>
</div>
