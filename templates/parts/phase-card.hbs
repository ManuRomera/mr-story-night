<aside class="mr-phase-card" aria-label="{{title}}">
  <div class="mr-phase-card__body">
    <p><strong>{{localize "MR.Guide.Now"}}:</strong> {{now}}</p>
    <p class="mr-phase-card__why"><strong>{{localize "MR.Guide.Why"}}:</strong> {{why}}</p>
  </div>
  <div class="mr-phase-card__actions">
    <button type="button" class="mr-link" data-action="mrTab" data-tab="guide" data-anchor="{{key}}">{{localize "MR.Guide.More"}}</button>
    <button type="button" class="mr-icon" data-action="toggleGuide" data-tooltip="{{localize 'MR.Guide.Hide'}}" aria-label="{{localize 'MR.Guide.Hide'}}"><i class="fa-solid fa-xmark"></i></button>
  </div>
</aside>
