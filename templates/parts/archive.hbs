{{#if viewing}}
<button type="button" class="mr-back mr-noprint" data-action="local" data-key="archiveId" data-value=""><i class="fa-solid fa-arrow-left"></i>{{localize "MR.Archive.Back"}}</button>
{{> "systems/mr-story-night/templates/parts/credits.hbs" viewing}}
{{else}}
<section class="mr-phase">
  <header class="mr-phase__head"><h2 class="mr-h1">{{localize "MR.Tab.archive"}}</h2><p class="mr-help">{{localize "MR.Archive.Help"}}</p></header>
  <div class="mr-archive-grid">
    {{#each list}}
    <article class="mr-archive-card">
      <span class="mr-eyebrow">{{date}}</span>
      <h3 class="mr-h2">{{title}}</h3>
      <p>{{goal}}</p>
      <p class="mr-meta"><span class="mr-result {{#if success}}is-success{{else}}is-failure{{/if}}">{{#if success}}{{localize "MR.Credits.Success"}}{{else}}{{localize "MR.Credits.Failure"}}{{/if}}</span><span>{{names}}</span></p>
      <button type="button" data-action="local" data-key="archiveId" data-value="{{id}}"><i class="fa-solid fa-book-open"></i>{{localize "MR.Archive.View"}}</button>
    </article>
    {{else}}<p class="mr-empty">{{localize "MR.Archive.Empty"}}</p>{{/each}}
  </div>
  <div class="mr-inline mr-import"><label class="mr-file-button"><i class="fa-solid fa-upload"></i>{{localize "MR.Archive.Import"}}<input type="file" accept=".json" data-import="story"></label></div>
</section>
{{/if}}
