<div class="mr-wizard-body">
  <header><span class="mr-eyebrow">{{localize "MR.NewStory.Step" step=step}}</span><h1>{{localize (concat "MR.NewStory.Step" step)}}</h1><div class="mr-progress"><i style="width: {{multiply step 20}}%"></i></div></header>
  {{#if (eq step 1)}}<div class="mr-choice-grid mr-genres">{{#each genres}}<button type="button" data-field="genre" data-value="{{this}}" class="mr-choice {{#if (eq this ../values.genre)}}is-selected{{/if}}"><i class="fas fa-masks-theater"></i><span>{{localize (concat "MR.Genre." this)}}</span></button>{{/each}}</div>{{/if}}
  {{#if (eq step 2)}}<div class="mr-choice-grid">{{#each (array "light" "adventure" "dramatic" "dark" "brutal" "absurd" "melancholic" "heroic" "unsettling")}}<button type="button" data-field="tone" data-value="{{this}}" class="mr-choice {{#if (includes this ../values.tone)}}is-selected{{/if}}"><span>{{localize (concat "MR.Tone." this)}}</span></button>{{/each}}</div><p class="mr-hint">{{localize "MR.NewStory.TwoTones"}}</p>{{/if}}
  {{#if (eq step 3)}}<div class="mr-choice-grid">{{#each (array "45" "60" "90" "120" "180" "open")}}<button type="button" data-field="duration" data-value="{{this}}" class="mr-choice {{#if (eq this ../values.duration)}}is-selected{{/if}}"><span>{{localize (concat "MR.Duration." this)}}</span></button>{{/each}}</div>{{/if}}
  {{#if (eq step 4)}}<div class="mr-choice-grid">{{#each (array "calm" "normal" "intense" "chaotic")}}<button type="button" data-field="intensity" data-value="{{this}}" class="mr-choice {{#if (eq this ../values.intensity)}}is-selected{{/if}}"><span>{{localize (concat "MR.Intensity." this)}}</span></button>{{/each}}</div>{{/if}}
  {{#if (eq step 5)}}<div class="mr-final"><div class="mr-mark">✦</div><h2>{{localize "MR.NewStory.Ready"}}</h2><p>{{localize "MR.NewStory.ReadyBody"}}</p><label>{{localize "MR.NewStory.Seed"}}<input name="seed" value="{{values.seed}}" placeholder="{{localize 'MR.NewStory.SeedPlaceholder'}}"></label></div>{{/if}}
  <footer>{{#unless (eq step 1)}}<button type="button" data-action="back">{{localize "MR.Action.Back"}}</button>{{/unless}}<span></span>{{#if (eq step 5)}}<button type="button" data-action="create" class="mr-primary">{{localize "MR.NewStory.Create"}}</button>{{else}}<button type="button" data-action="next" class="mr-primary">{{localize "MR.Action.Next"}}</button>{{/if}}</footer>
</div>
