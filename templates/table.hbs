<div class="mr-table" data-mr-theme="{{theme}}">
  <header class="mr-top">
    <div class="mr-top__title">
      <span class="mr-eyebrow">{{header.eyebrow}}</span>
      <h1>{{header.title}}</h1>
      {{#if header.subtitle}}<p>{{header.subtitle}}</p>{{/if}}
    </div>
    {{#if header.steps.length}}
    <ol class="mr-steps" aria-label="{{localize 'MR.Step.Label'}}">
      {{#each header.steps}}
      <li class="mr-step is-{{state}}" {{#if (eq state "current")}}aria-current="step"{{/if}}>
        <span class="mr-step__dot">{{#if stones}}{{#each stones}}<i class="mr-stone mr-stone--{{color}} mr-stone--xs"></i>{{/each}}{{else}}{{#if (eq ../state "done")}}<i class="fa-solid fa-check"></i>{{/if}}{{/if}}</span>
        <span class="mr-step__label">{{label}}</span>
      </li>
      {{/each}}
    </ol>
    {{/if}}
  </header>

  <nav class="mr-tabs" aria-label="{{localize 'MR.Tab.Label'}}">
    {{#each tabs}}<button type="button" class="mr-tab {{#if active}}is-active{{/if}}" data-action="tab" data-tab="{{key}}" {{#if active}}aria-current="page"{{/if}}><i class="{{icon}}"></i><span>{{label}}</span></button>{{/each}}
    <span class="mr-tabs__spacer"></span>
    {{#if canUndo}}<button type="button" class="mr-tab" data-action="undo" data-tooltip="{{localize 'MR.Action.UndoHint'}}"><i class="fa-solid fa-rotate-left"></i><span>{{localize "MR.Action.Undo"}}</span></button>{{/if}}
  </nav>

  <div class="mr-layout {{#if showSide}}has-side{{/if}}">
    <main class="mr-main mr-scroll">
      {{#if lobby}}{{> "systems/mr-story-night/templates/parts/lobby.hbs" lobby}}{{/if}}
      {{#if setup}}{{> "systems/mr-story-night/templates/parts/setup.hbs" setup}}{{/if}}
      {{#if characters}}{{> "systems/mr-story-night/templates/parts/characters.hbs" characters}}{{/if}}
      {{#if challenge}}{{> "systems/mr-story-night/templates/parts/challenge.hbs" challenge}}{{/if}}
      {{#if epilogue}}{{> "systems/mr-story-night/templates/parts/epilogue.hbs" epilogue}}{{/if}}
      {{#if credits}}{{> "systems/mr-story-night/templates/parts/credits.hbs" credits}}{{/if}}
      {{#if chronicle}}{{> "systems/mr-story-night/templates/parts/chronicle.hbs" chronicle}}{{/if}}
      {{#if quests}}{{> "systems/mr-story-night/templates/parts/quests.hbs" quests}}{{/if}}
      {{#if safety}}{{> "systems/mr-story-night/templates/parts/safety.hbs" safety}}{{/if}}
      {{#if archive}}{{> "systems/mr-story-night/templates/parts/archive.hbs" archive}}{{/if}}
    </main>
    {{#if showSide}}<aside class="mr-side mr-scroll" aria-label="{{localize 'MR.Company.Title'}}">{{> "systems/mr-story-night/templates/parts/company.hbs" company}}</aside>{{/if}}
  </div>
</div>
