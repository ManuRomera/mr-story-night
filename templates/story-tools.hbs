<div class="mr-tools-shell">
  <nav class="mr-tool-tabs">
    <button data-section="relationships" class="{{#if (eq section 'relationships')}}is-active{{/if}}"><i class="fas fa-share-nodes"></i>{{localize "MR.Relationships.Title"}}</button>
    <button data-section="archive" class="{{#if (eq section 'archive')}}is-active{{/if}}"><i class="fas fa-box-archive"></i>{{localize "MR.Archive.Title"}}</button>
    {{#if isGM}}<button data-section="content" class="{{#if (eq section 'content')}}is-active{{/if}}"><i class="fas fa-pen-ruler"></i>{{localize "MR.Content.Title"}}</button>{{/if}}
    <button data-section="safety" class="{{#if (eq section 'safety')}}is-active{{/if}}"><i class="fas fa-shield-heart"></i>{{localize "MR.Safety.Title"}}</button>
    <button data-section="audio" class="{{#if (eq section 'audio')}}is-active{{/if}}"><i class="fas fa-volume-high"></i>{{localize "MR.Audio.Title"}}</button>
    <button data-section="finale" class="{{#if (eq section 'finale')}}is-active{{/if}}"><i class="fas fa-film"></i>{{localize "MR.Finale.Title"}}</button>
  </nav>
  {{#if (eq section "relationships")}}<section class="mr-tool-panel">
    <header><h1>{{localize "MR.Relationships.Title"}}</h1><p>{{localize "MR.Relationships.Help"}}</p></header>
    <div class="mr-relation-board">
      <svg aria-hidden="true">{{#each relations}}<line x1="{{source.x}}%" y1="{{source.y}}%" x2="{{target.x}}%" y2="{{target.y}}%"></line><text x="{{midpoint source.x target.x}}%" y="{{midpoint source.y target.y}}%">{{localize (concat "MR.Relationship." kind)}}</text>{{/each}}</svg>
      {{#each nodes}}<button class="mr-relation-node" data-actor-id="{{actor.id}}" style="left:{{x}}%;top:{{y}}%"><img src="{{actor.img}}" alt=""><span>{{actor.name}}</span></button>{{/each}}
    </div>
    {{#if isGM}}<div class="mr-inline-form"><select name="source"><option value="">{{localize "MR.Relationships.From"}}</option>{{#each characters}}<option value="{{id}}">{{name}}</option>{{/each}}</select><select name="kind">{{#each (array "trust" "debt" "love" "rivalry" "fear" "family" "shared-secret" "betrayal" "protection" "admiration")}}<option value="{{this}}">{{localize (concat "MR.Relationship." this)}}</option>{{/each}}</select><select name="target"><option value="">{{localize "MR.Relationships.To"}}</option>{{#each characters}}<option value="{{id}}">{{name}}</option>{{/each}}</select><input name="detail" placeholder="{{localize 'MR.Relationships.Detail'}}"><button class="mr-primary" data-action="add-relation">{{localize "MR.Action.Add"}}</button></div>{{/if}}
    <div class="mr-relation-list">{{#each relations}}<article><strong>{{source.actor.name}}</strong><span>{{localize (concat "MR.Relationship." kind)}}</span><strong>{{target.actor.name}}</strong><small>{{detail}}</small>{{#if ../isGM}}<button data-action="delete-relation" data-id="{{id}}"><i class="fas fa-trash"></i></button>{{/if}}</article>{{/each}}</div>
  </section>{{/if}}
  {{#if (eq section "archive")}}<section class="mr-tool-panel"><header><h1>{{localize "MR.Archive.Title"}}</h1><p>{{localize "MR.Archive.Help"}}</p></header><div class="mr-archive-grid">{{#each archive}}<article><span>{{localize (concat "MR.Genre." genre)}}</span><h2>{{title}}</h2><p>{{premise}}</p><small>{{scenes.length}} {{localize "MR.Archive.Scenes"}}</small>{{#if ../isGM}}<button data-action="restore-story" data-id="{{id}}">{{localize "MR.Archive.Restore"}}</button>{{/if}}</article>{{else}}<p class="mr-empty">{{localize "MR.Archive.Empty"}}</p>{{/each}}</div><div class="mr-import-export">{{#if story}}<button data-action="export-story"><i class="fas fa-download"></i>{{localize "MR.Archive.Export"}}</button>{{/if}}{{#if isGM}}<label class="mr-file-button"><i class="fas fa-upload"></i>{{localize "MR.Archive.Import"}}<input type="file" name="story-pack" accept=".json,.mrstory.json"></label>{{/if}}</div></section>{{/if}}
  {{#if (eq section "content")}}<section class="mr-tool-panel"><header><h1>{{localize "MR.Content.Title"}}</h1><p>{{localize "MR.Content.Help"}}</p></header><div class="mr-editor-grid"><label>{{localize "MR.Content.Prompts"}}<textarea name="prompts">{{join custom.prompts "\n"}}</textarea></label><label>{{localize "MR.Content.Complications"}}<textarea name="complications">{{join custom.complications "\n"}}</textarea></label></div><button class="mr-primary" data-action="save-content">{{localize "MR.Action.Save"}}</button></section>{{/if}}
  {{#if (eq section "safety")}}<section class="mr-tool-panel mr-safety"><header><h1>{{localize "MR.Safety.Title"}}</h1><p>{{localize "MR.Safety.Help"}}</p></header><div class="mr-safety-actions"><button data-action="safety-signal" data-signal="pause" class="mr-danger"><i class="fas fa-hand"></i>{{localize "MR.Safety.Pause"}}</button><button data-action="safety-signal" data-signal="rewind"><i class="fas fa-backward"></i>{{localize "MR.Safety.Rewind"}}</button><button data-action="safety-signal" data-signal="fade"><i class="fas fa-forward"></i>{{localize "MR.Safety.Fade"}}</button>{{#if isGM}}<button data-action="resume" class="mr-primary">{{localize "MR.Safety.Resume"}}</button>{{/if}}</div><p class="mr-privacy">{{localize "MR.Safety.Privacy"}}</p>{{#if isGM}}<div class="mr-editor-grid"><label>{{localize "MR.Safety.Lines"}}<textarea name="lines">{{join safety.lines "\n"}}</textarea></label><label>{{localize "MR.Safety.Veils"}}<textarea name="veils">{{join safety.veils "\n"}}</textarea></label></div><button data-action="save-safety">{{localize "MR.Action.Save"}}</button>{{/if}}</section>{{/if}}
  {{#if (eq section "audio")}}<section class="mr-tool-panel"><header><h1>{{localize "MR.Audio.Title"}}</h1><p>{{localize "MR.Audio.Help"}}</p></header><div class="mr-audio-grid">{{#each (array "neutral" "noir" "horror" "cosmic" "fantasy" "dark-fantasy" "sci-fi" "cyberpunk" "post-apocalyptic" "western" "1920s" "contemporary" "pulp" "mystery" "gothic" "space-survival")}}<button data-action="audio-play" data-theme="{{this}}"><i class="fas fa-wave-square"></i>{{localize (concat "MR.Theme." this)}}</button>{{/each}}</div><button data-action="audio-stop" class="mr-danger"><i class="fas fa-stop"></i>{{localize "MR.Audio.Stop"}}</button></section>{{/if}}
  {{#if (eq section "finale")}}<section class="mr-tool-panel mr-credits"><div class="mr-mark">✦</div><span class="mr-eyebrow">MR · STORY NIGHT</span><h1>{{story.title}}</h1><p class="mr-credit-premise">{{story.premise}}</p><h2>{{localize "MR.Finale.Cast"}}</h2><div class="mr-credit-cast">{{#each characters}}<article><img src="{{img}}" alt=""><strong>{{name}}</strong><span>{{system.concept}}</span></article>{{/each}}</div><h2>{{localize "MR.Finale.Story"}}</h2><ol>{{#each story.history}}<li>{{label}}</li>{{/each}}</ol><p>{{localize "MR.Finale.Thanks"}}</p><button data-action="print-finale"><i class="fas fa-print"></i>{{localize "MR.Finale.Export"}}</button></section>{{/if}}
</div>
