<div class="mr-sheet mr-table" data-mr-theme="{{theme}}">
  <header class="mr-bar">
    <div class="mr-bar__title">
      <span class="mr-eyebrow">{{header.eyebrow}}</span>
      <h1>{{header.title}}</h1>
      {{#if header.goal}}<p>{{header.goal}}</p>{{/if}}
    </div>
    {{#if header.steps.length}}
    <ol class="mr-steps" aria-label="{{localize 'MR.Step.Label'}}">
      {{#each header.steps}}
      <li class="mr-step is-{{state}} {{#if isChallenge}}is-challenge{{/if}}" data-tooltip="{{long}}" {{#if (eq state "current")}}aria-current="step"{{/if}}>
        <span class="mr-step__dot">{{#if stones}}{{#each stones}}<i class="mr-stone mr-stone--{{color}} mr-stone--xs"></i>{{/each}}{{else}}{{#if isChallenge}}{{label}}{{else}}{{#if (eq ../state "done")}}<i class="fa-solid fa-check"></i>{{/if}}{{/if}}{{/if}}</span>
        {{#unless isChallenge}}<span class="mr-step__label">{{label}}</span>{{/unless}}
      </li>
      {{/each}}
    </ol>
    {{/if}}
  </header>

  {{#if turn}}<p class="mr-turn {{#if turn.mine}}is-mine{{/if}}" role="status"><i class="{{turn.icon}}"></i><span>{{turn.text}}</span></p>{{/if}}

  <nav class="mr-tabs" aria-label="{{localize 'MR.Tab.Label'}}">
    {{#each tabs}}<button type="button" class="mr-tab {{#if active}}is-active{{/if}}" data-action="mrTab" data-tab="{{key}}" {{#if active}}aria-current="page"{{/if}}><i class="{{icon}}"></i><span>{{label}}</span></button>{{/each}}
    <span class="mr-tabs__spacer"></span>
    {{#unless isActive}}{{#if isGM}}{{#unless complete}}<button type="button" class="mr-tab" data-action="activate"><i class="fa-solid fa-star"></i><span>{{localize "MR.Action.Activate"}}</span></button>{{/unless}}{{/if}}{{/unless}}
    {{#if guideHidden}}<button type="button" class="mr-tab" data-action="toggleGuide"><i class="fa-solid fa-circle-question"></i><span>{{localize "MR.Guide.Show"}}</span></button>{{/if}}
    {{#if canUndo}}<button type="button" class="mr-tab" data-action="undo" data-tooltip="{{localize 'MR.Action.UndoHint'}}"><i class="fa-solid fa-rotate-left"></i><span>{{localize "MR.Action.Undo"}}</span></button>{{/if}}
    <button type="button" class="mr-tab mr-tab--icon" data-action="lobby" data-tooltip="{{localize 'MR.Lobby.Window'}}" aria-label="{{localize 'MR.Lobby.Window'}}"><i class="fa-solid fa-door-open"></i></button>
  </nav>

  {{#if empty}}
  <div class="mr-empty-state">
    <i class="fa-solid fa-people-group"></i>
    <p>{{localize "MR.Fellowship.Empty"}}</p>
    <button type="button" class="mr-primary" data-action="lobby"><i class="fa-solid fa-door-open"></i>{{localize "MR.Lobby.Window"}}</button>
  </div>
  {{else}}
  <div class="mr-layout {{#if showSide}}has-side{{/if}}">
    <main class="mr-main">
      {{#if phaseCard}}{{> "systems/mr-story-night/templates/parts/phase-card.hbs" phaseCard}}{{/if}}
      {{#if setup}}{{> "systems/mr-story-night/templates/parts/setup.hbs" setup}}{{/if}}
      {{#if characters}}{{> "systems/mr-story-night/templates/parts/characters.hbs" characters}}{{/if}}
      {{#if challenge}}{{> "systems/mr-story-night/templates/parts/challenge.hbs" challenge}}{{/if}}
      {{#if epilogue}}{{> "systems/mr-story-night/templates/parts/epilogue.hbs" epilogue}}{{/if}}
      {{#if credits}}{{> "systems/mr-story-night/templates/parts/credits.hbs" credits}}{{/if}}
      {{#if company}}{{> "systems/mr-story-night/templates/parts/company.hbs" company}}{{/if}}
      {{#if chronicle}}{{> "systems/mr-story-night/templates/parts/chronicle.hbs" chronicle}}{{/if}}
      {{#if guide}}{{> "systems/mr-story-night/templates/parts/guide.hbs" guide}}{{/if}}
      {{#if safety}}{{> "systems/mr-story-night/templates/parts/safety.hbs" safety}}{{/if}}
    </main>
    {{#if showSide}}<aside class="mr-side" aria-label="{{localize 'MR.Company.Title'}}">{{> "systems/mr-story-night/templates/parts/members.hbs" members=members}}</aside>{{/if}}
  </div>
  {{/if}}
</div>
